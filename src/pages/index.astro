---
import '../styles/landing.css';
import Feature from '../components/Feature.astro';
import icon from '../assets/icon.svg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const shot = (name: string) => `${base}shots/${name}.webp`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Stache — Where is my stuff?</title>
		<meta
			name="description"
			content="Stache is a self-hosted, photo-first home inventory app. Snap a photo, label the bin, find it later. Runs in one container — no database, no cloud, no forms."
		/>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
	</head>
	<body>
		<nav class="top-nav">
			<a href={`${base}docs/`}>Docs</a>
		</nav>
		<header class="hero">
			<img class="hero-icon" src={icon.src} alt="Stache logo" width="128" height="128" />
			<h1>Stache</h1>
			<p class="tagline">Where is my stuff?</p>
			<p class="sub">
				Snap a photo. Drop it in a bin. Scan the bin's label. That's the whole
				system — a self-hosted home inventory for people who won't fill in forms.
			</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href={`${base}docs/getting-started/home-assistant/`}>Get started</a>
				<a class="btn btn-ghost" href="https://github.com/GraphicHealer/Stache">
					<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
					</svg>
					GitHub
				</a>
			</div>
			<svg class="scroll-cue" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m6 9 6 6 6-6" />
			</svg>
		</header>

		<main class="features">
			<Feature
				kicker="Capture"
				title="Snap it and it's filed"
				shot={shot('home')}
				alt="Stache home screen with a freshly photographed item"
			>
				A photo is the whole record. No names required, no categories, no
				forms — point, shoot, done. Name it later if you feel like it. Or
				never.
				<ul slot="points">
					<li>Works offline — syncs when you're back</li>
					<li>Made for your phone's camera</li>
				</ul>
			</Feature>

			<Feature
				kicker="Organize"
				title="Label the bin, not the stuff"
				flip
				shot={shot('area')}
				alt="Stache area page showing the contents of a labeled bin"
			>
				Print a QR label, stick it on a bin, shelf, or drawer. Scan it once to
				claim it — scan it anytime to see what's inside without opening a lid.
			</Feature>

			<Feature
				kicker="Find"
				title="Search by words — or by photo"
				shot={shot('search')}
				alt="Stache search results"
			>
				Type what you remember — typos are fine — or drop in a photo and let
				Stache find things that look like it. Scan a product barcode and it
				fills in the rest.
			</Feature>

			<Feature
				kicker="Keep track"
				title="Know what's out"
				flip
				shot={shot('out')}
				alt="Stache list of items that are lent out or away"
			>
				Lent the drill? Borrowed the ladder? Mark it out in one tap and get a
				quiet reminder of what's still gone — never a nagging badge.
			</Feature>

			<Feature
				kicker="Relax"
				title="Can't break anything"
				shot={shot('trash')}
				alt="Stache trash showing recently removed items"
			>
				Filed it wrong? Deleted by mistake? Every action is undoable and
				nothing is ever really destroyed — the trash keeps it all.
			</Feature>
		</main>

		<footer class="site-footer">
			<p>
				<strong>Stache</strong> is free, self-hosted software. One container, no
				database service, your photos never leave your house.
			</p>
			<p>
				<a href="https://github.com/GraphicHealer/Stache">GitHub</a>
				&nbsp;·&nbsp;
				<a href={`${base}docs/getting-started/home-assistant/`}>Documentation</a>
			</p>
			<p>
				Demo photos via <a href="https://commons.wikimedia.org">Wikimedia Commons</a>
				contributors — <a href={`${base}credits/`}>credits</a>.
			</p>
		</footer>

		<script is:inline>
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
			);
			document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		</script>
	</body>
</html>
